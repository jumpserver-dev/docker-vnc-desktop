diff --git a/common/rfb/SMsgReader.cxx b/common/rfb/SMsgReader.cxx
index 1ab213a..c55d105 100644
--- a/common/rfb/SMsgReader.cxx
+++ b/common/rfb/SMsgReader.cxx
@@ -43,6 +43,12 @@ static core::IntParameter maxCutText("MaxCutText",
                                      "incoming clipboard update",
                                      256*1024, 0, INT_MAX);
 
+static core::BoolParameter acceptLegacyClipboardUTF8(
+  "AcceptLegacyClipboardUTF8",
+  "Preserve valid UTF-8 received through legacy ClientCutText messages; "
+  "otherwise decode the message as Latin-1",
+  true);
+
 SMsgReader::SMsgReader(SMsgHandler* handler_, rdr::InStream* is_)
   : handler(handler_), is(is_), state(MSGSTATE_IDLE)
 {
@@ -344,7 +350,13 @@ bool SMsgReader::readClientCutText()
   std::vector<char> ca(len);
   is->readBytes((uint8_t*)ca.data(), len);
 
-  std::string utf8(core::latin1ToUTF8(ca.data(), ca.size()));
+  std::string utf8;
+  if (acceptLegacyClipboardUTF8 &&
+      core::isValidUTF8(ca.data(), ca.size())) {
+    utf8.assign(ca.data(), ca.size());
+  } else {
+    utf8 = core::latin1ToUTF8(ca.data(), ca.size());
+  }
   std::string filtered(core::convertLF(utf8.data(), utf8.size()));
 
   handler->clientCutText(filtered.c_str());
